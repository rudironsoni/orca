-    if (kind === 'motion' && mouseTrackingMode !== 'drag' && mouseTrackingMode !== 'any') return '';
-    if (kind === 'release' && mouseTrackingMode === 'x10') return '';
-    var cell = viewportToMouseReportCell(clientX, clientY);
