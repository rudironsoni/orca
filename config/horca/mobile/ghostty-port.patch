-    var sgrButton = kind === 'motion' ? 32 : 0;
-    var sgrFinal = kind === 'release' ? 'm' : 'M';
-    if (sgrMousePixelsMode) {
-      if (!isSafeSgrMouseCoordinate(cell.x) || !isSafeSgrMouseCoordinate(cell.y)) return '';
