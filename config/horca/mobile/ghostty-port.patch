-    document.getElementById('terminal-container').appendChild(swap.nextSurface);
-    surface = swap.nextSurface;
-    pendingSurface = swap.nextSurface;
-    attachSurfaceEventHandlers(surface);
-    swap.oldSurface.removeAttribute('id');
