diff --git c/mobile/packages/libghostty-terminal/ios/vendor/GhosttyTerminal/View/TerminalViewRepresentable.swift i/mobile/packages/libghostty-terminal/ios/vendor/GhosttyTerminal/View/TerminalViewRepresentable.swift
