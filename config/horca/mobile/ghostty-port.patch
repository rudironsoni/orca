diff --git c/mobile/packages/libghostty-terminal/ios/vendor/GhosttyTerminal/Platform/Shared/TerminalIMEComposition.swift i/mobile/packages/libghostty-terminal/ios/vendor/GhosttyTerminal/Platform/Shared/TerminalIMEComposition.swift
